      },
      "precomputed-noise-textures": {
        "name": "优化动态光源",
        "hint": "通过使用预计算的FBM噪声纹理来优化某些动态光源(扭曲波、彩灯、幽光、雾斑、扭曲彩虹、涡流)的着色器。视觉影响很小，但对性能提升显著，特别是在低端GPU上。"
      },
      "reduce-lighting-resolution": {
        "name": "缩放光照效果分辨率",
        "hint": "降低光照效果的内部分辨率以提高性能。这可以显著提升性能，特别是当使用多个光源或大型光源时。视觉影响应该很小，除了在极高缩放级别和一些具有清晰轮廓的光照效果(如六角穹顶纹)。你可以在设置菜单中为各个光照层配置渲染比例。"
      },
      "spritesheet-substitution": {
        "name": "使用精灵表替换纹理",
        "hint": "用优化的精灵表替换核心SVG图标和其他图形元素。当显示大量UI图标(如日志、光源、门等)时，这可以提高性能和资源利用率。"
      },
      "spritesheet-substitution-custom": {
