          "dwarf": {
            "name": "矮人",
            "description": "结实而有韧性，矮人以他们的工艺、耐力以及与山脉和石工的深厚联系而闻名。他们通常矮小粗壮，有着浓密的胡须和强调其坚韧的结实体格。"
          },
          "elf": {
            "name": "精灵",
            "description": "优雅而长寿，精灵拥有敏锐的感官、对魔法的自然亲和力以及与自然的持久联系。他们高大苗条，有着尖耳朵、棱角分明的特征和超凡脱俗的美貌。"
          },
          "halfling": {
            "name": "半身人",
            "description": "小巧而灵活，半身人开朗且足智多谋，以他们的运气和避开危险的能力而闻名。他们矮小，大约三英尺高，有着圆脸、卷发和友好的举止。"
          },
          "human": {
            "name": "人类",
            "description": "多才多艺且雄心勃勃，人类适应任何环境，擅长各种技能和职业。他们在身高、体格、肤色和面部特征上差异很大，反映了他们文化的多样性。"
          },
          "dragonborn": {
            "name": "龙裔",
            "description": "骄傲而强大，龙裔是人形龙类，有着强烈的荣誉感和天生的吐息武器。他们高大肌肉发达，覆盖着彩色鳞片，有着爬行动物的头部、爪状手和尾巴。"
          },
          "gnome": {
            "name": "侏儒",
            "description": "好奇且富有创造力，侏儒小巧灵活，以敏锐的头脑和对修补的热爱而闻名。他们矮小，有着尖耳朵、淘气的举止和寻找隐藏宝藏的技巧。"
          },
          "half-elf": {
            "name": "半精灵",
            "description": "融合了人类的多才多艺和精灵的优雅，半精灵富有魅力且适应性强，适合两个世界但又不完全属于任何一个。他们有略微尖的耳朵、棱角分明的面部特征，以及因血统而异的人类和精灵特征的混合。"
          },
          "half-orc": {
            "name": "半兽人",
            "description": "强壮而坚韧，半兽人继承了兽人血统的耐力和战斗精神，同时常常努力证明自己超越于此。他们高大强壮，有着绿色或灰色的皮肤、突出的下獠牙和浓密的眉毛。"
          },
          "tiefling": {
            "name": "提夫林",
            "description": "被地狱血统标记，提夫林拥有恶魔特征、天生的火焰抗性和魔法天赋。他们有角、尾巴和不寻常的眼睛和皮肤颜色，范围从深红色到紫色和蓝色。"
          }
