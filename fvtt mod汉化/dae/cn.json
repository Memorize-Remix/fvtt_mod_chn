  "dae.Macros.fieldData": {
	"macro.actorUpdate": {
	  "name": "更新角色字段",
	  "description": "允许你更新角色身上的某个字段，并（可选地）在效果失效时撤销该更新。不过它并不会锁定字段值，而是通过 actor.update 来实现变更。这样你就能编写各种效果，而无需为它们单独创建宏。详情查阅FVTT中文教程—自动化教程—macro.actorUpdate使用方法"
	},
	"macro.CE": {
	  "name": "应用DCE效果",
	  "description": ""
	},
	"macro.createItem": {
	  "name": "创建物品",
	  "description": "值为要创建物品的UUID，你可以直接将物品拖到值的框中自动生成，此键值允许你在效果创建时为效果应用的目标创建一个物品，并在效果移除时自动删除它。"
	},
	"macro.createItemRunMacro": {
	  "name": "创建物品并运行宏",
	  "description": "其行为与 macro.createItem 相同，但此外，当物品在角色身上创建时，DAE 将运行该物品的物品宏，args[0] 设置为onCreate，允许你将创建物品的 uuid（在 lastArg 中传递）保存到某处以供将来参考。"
	},
	"macro.execute": {
	  "name": "执行的宏",
	  "description": "效果创建/删除/每回合执行宏。详情查阅FVTT中文教程—自动化教程—主动效果（AE）系统综述-DAE宏"
	},
	"macro.execute.GM": {
	  "name": "GM执行的宏",
	  "description": "与\"macro.execute\"相同，但宏执行强制由GM进行。"
	},
	"macro.execute.local": {
	  "name": "本地执行的宏",
	  "description": "与\"macro.execute\"相同，但宏执行强制在本地客户端进行。"
	},
	"macro.itemMacro": {
	  "name": "执行物品宏/DIME",
	  "description": "效果创建/删除/每回合执行物品上存储的宏/DIME(midi标签页上的宏)。详情查阅FVTT中文教程—自动化教程—主动效果（AE）系统综述-DAE宏"
	},
	"macro.itemMacro.GM": {
	  "name": "以GM身份执行物品宏/DIME",
	  "description": "与\"macro.itemMacro\"相同，但宏执行强制由GM进行。"
	},
	"macro.itemMacro.local": {
	  "name": "本地执行物品宏/DIME",
	  "description": "与\"macro.itemMacro\"相同，但宏执行强制在本地客户端进行。"
	},
	"macro.StatusEffect": {
	  "name": "应用状态效果",
	  "description": "实际上与在详情页选择状态相同，但以编程方式创建状态，并且不强制显示被动效果。"
	}
  },
