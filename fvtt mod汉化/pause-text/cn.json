        "choices": {
          "none": "无",
          "capitalize": "首字母大写",
          "uppercase": "全部大写"
        }
      }
    },
    "animation": {
      "animationType": {
        "name": "动画类型：",
        "hint": "设置整个暂停元素的动画效果。默认：脉动",
