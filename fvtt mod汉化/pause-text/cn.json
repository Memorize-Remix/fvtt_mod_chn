      },
      "lineHeight": {
        "name": "行高 (rem)：",
        "hint": "文本行的高度（rem 单位），多行文本建议值为 2。默认：1rem"
      },
      "lineOffset": {
        "name": "垂直行偏移 (px)：",
        "hint": "消息行相对于图像的垂直偏移。负值向上偏移，正值向下偏移。关闭背景时效果最佳。默认：0px"
      },
      "textShadow": {
        "name": "启用阴影效果：",
        "hint": "启用时文本下方显示阴影。"
      },
      "textAlign": {
        "name": "多行文本对齐：",
        "hint": "在多行文本框内对齐文本。默认：居中",
