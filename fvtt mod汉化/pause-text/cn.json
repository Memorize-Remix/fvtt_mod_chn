	  "textSelectionMode": {
		"name": "文本选择模式：",
		"hint": "选择暂停文本消息的选取方式。\n“顺序”按顺序显示消息，并记住上次位置直到会话重新加载。\n“随机”使用真随机。\n“随机（减少重复）”使用受Tetris The Grand Master启发的算法，减少最近重复的消息。默认：随机",
		"choices": {
		  "ordered": "顺序",
		  "random": "随机",
		  "perceivedRandom": "随机（减少重复）"
		}
	  },
      "changeInterval": {
        "name": "文本切换间隔：",
