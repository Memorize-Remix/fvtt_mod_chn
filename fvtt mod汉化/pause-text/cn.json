          "none": "无",
          "pulse": "脉动",
          "rainbow": "彩虹",
          "breath": "呼吸",
          "glow": "发光"
        }
      },
      "animationDuration": {
        "name": "动画持续时间：",
        "hint": "设置动画的持续时间（秒）。默认：3秒"
      },
      "animationColor": {
        "name": "动画颜色：",
        "hint": "某些动画可以更改颜色。默认：#ffffff"
      }
