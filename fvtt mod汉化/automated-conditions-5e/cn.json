	"dae.AC5E.fieldData": {
		"flags.automated-condition-5e.crossbowExpert": {
			"name": "强弩专家",
			"description": "你用弩进行的攻击检定不会因你在敌人的5尺内而具有劣势。"
		},
		"flags.automated-condition-5e.sharpShooter": {
			"name": "神射手",
			"description": "位于一个敌人5尺范围内的情况下，你使用远程武器发动的攻击检定不会因此具有劣势。"
		},
		"flags.automated-condition-5e.spellSniper": {
			"name": "法术射手",
			"description": "2024 规则下，在敌人5尺范围内施放射程至少10尺的远程法术时不会承受劣势，并额外增加60尺射程"
		},
		"flags.automated-conditions-5e.attack.criticalThreshold": {
			"name": "调整重击阈值",
			"description": "使用 threshold=-5 降低5点或 set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		},
