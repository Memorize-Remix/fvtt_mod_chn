		},
		"flags.automated-conditions-5e.aura.attack.criticalThreshold": {
			"name": "光环：调整范围内生物的重击阈值",
			"description": "使用 radius=15;threshold=-5 降低5点或 radius=20;set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		},
		"flags.automated-conditions-5e.attack.fumbleThreshold": {
			"name": "调整攻击的大失败阈值",
			"description": "使用 threshold=5 增加5点，或 set=15 将值设为15。可以使用掷骰数据、骰子公式和评估条件"
		  },
		  "flags.automated-conditions-5e.grants.attack.fumbleThreshold": {
			"name": "被攻击时，调整攻击者攻击的大失败阈值",
			"description": "使用 threshold=-5 降低5点或 set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		  },
		  "flags.automated-conditions-5e.aura.attack.fumbleThreshold": {
			"name": "光环：调整范围内生物攻击的大失败阈值",
			"description": "使用 radius=15;threshold=-5 降低5点或 radius=20;set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		  },
		"flags.automated-conditions-5e.damage.extraDice": {
			"name": "增加或减少掷骰的骰子数量",
			"description": "使用 bonus=4 增加4个骰子数量"
		},
		"flags.automated-conditions-5e.grants.damage.extraDice": {
