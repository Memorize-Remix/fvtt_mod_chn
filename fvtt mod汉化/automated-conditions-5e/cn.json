		},
		"flags.automated-conditions-5e.modifyAC": {
			"name": "调整角色的AC",
			"description": "使用 bonus=5 增加5点AC或 set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		},
		"flags.automated-conditions-5e.grant.modifyAC": {
			"name": "调整与该目标对抗生物的AC",
			"description": "使用 bonus=-5 减少5点AC或 set=15 设置为15。可以使用掷骰数据、骰子公式和评估条件"
		},
		"flags.automated-conditions-5e.aura.modifyAC": {
			"name": "光环：调整范围内生物的AC",
			"description": "使用 radius=10;bonus=1d4; 或 radius=15;set=15。前者将给予AC加值，后者将设置为提供的值"
		},
		"flags.automated-conditions-5e.ACTIONTYPE": {
			"advantage": {
				"name": "掷骰获得优势",
				"description": "将ACTIONTYPE替换为以下选项之一：all/attack/check/concentration/damage/death/initiative/save/skill/tool"
			},
			"bonus": {
				"name": "掷骰获得加值",
				"description": "将ACTIONTYPE替换为以下选项之一：all/attack/check/concentration/damage/death/initiative/save/skill/tool. 例如bonus=1d4 + 5 - rollingActor.abilities.dex.mod;"
			},
			"critical": {
				"name": "掷骰强制大成功(N20或重击伤害)",
				"description": "将ACTIONTYPE替换为以下选项之一：all/attack/check/concentration/damage/death/initiative/save/skill/tool"
			},
			"disadvantage": {
				"name": "掷骰承受劣势",
				"description": "将ACTIONTYPE替换为以下选项之一：all/attack/check/concentration/damage/death/initiative/save/skill/tool"
			},
			"modifier": {
				"name": "D20检定的最小和最大修饰符，伤害掷骰的最大和任意修饰符",
				"description": "将ACTIONTYPE替换为以下之一：attack/check/concentration/damage/death/initiative/save/skill/tool。例如：modifier=(rollingActor.attributes.hp.pct < 50 ? max8 : min12)。关于修饰符，你可以参考FVTT中文教程-FVTT 基础教程-掷骰公式-特殊运算符"
			},
			"modifyDC": {
				"name": "调整你行动的豁免DC。也适用于你进行的专注豁免和死亡豁免",
