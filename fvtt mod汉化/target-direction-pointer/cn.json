
  "TDP": {
    "settings": {
      "enabled": {
        "name": "启用指针",
        "hint": "在Token上显示指向其目标的指示箭头。"
      },
      "gmShowAll": {
        "name": "GM 查看全部",
        "hint": "启用后，GM 可以看到所有玩家的目标指针，而不仅仅是自己的。"
      },
      "baseHalfWidth": {
        "name": "箭头底部宽度",
        "hint": "箭头底部半宽（以像素为单位，基于 1x1 Token比例）。默认值：6"
      },
      "baseLength": {
        "name": "箭头最小长度",
        "hint": "箭头最小长度（以像素为单位）。默认值：12"
      },
      "maxLength": {
        "name": "箭头最大长度",
        "hint": "箭头最大长度（以像素为单位，基于 1x1 Token比例）。默认值：30"
      },
      "distFactor": {
        "name": "距离缩放系数",
        "hint": "每格距离箭头长度增加多少。默认值：1.5"
      },
      "offset": {
        "name": "边框偏移量",
        "hint": "Token边缘与箭头底部之间的间隙（以像素为单位）。默认值：2"
      },
      "outlineWidth": {
        "name": "轮廓宽度",
        "hint": "箭头周围深色轮廓的宽度（以像素为单位）。默认值：1.5"
      },
      "alphaClose": {
        "name": "近处不透明度",
        "hint": "最近目标箭头的不透明度（0-1）。默认值：0.90"
      },
      "alphaFar": {
        "name": "远处不透明度",
        "hint": "最远目标箭头的不透明度下限（0-1）。默认值：0.35"
      },
      "alphaFalloff": {
        "name": "不透明度衰减距离",
        "hint": "不透明度从近到远衰减的格数。默认值：20"
      },
      "breathSpeed": {
        "name": "呼吸速度",
        "hint": "呼吸动画振荡的速度。设置为 0 以禁用。默认值：0.0015"
      },
      "breathDepth": {
        "name": "呼吸强度",
        "hint": "呼吸动画的振幅（0 表示禁用）。默认值：0.12"
      },
      "colorHostile": {
        "name": "敌对颜色",
        "hint": "跨阵营目标（例如玩家角色 vs 怪物）的箭头颜色。默认值：#ff4444"
      },
      "colorFriendly": {
        "name": "友好颜色",
        "hint": "友方对友方目标的箭头颜色。默认值：#44ddaa"
      },
      "colorNeutral": {
        "name": "中立颜色",
        "hint": "同敌对阵营或模糊目标的箭头颜色。默认值：#f0c020"
      }
    },
    "keybinding": {
      "toggle": {
        "name": "切换目标指针",
        "hint": "开启/关闭方向性目标指针。"
      }
    },
    "notifications": {
      "on": "目标方向指针已开启。",
      "off": "目标方向指针已关闭。"
    }
  }
}
